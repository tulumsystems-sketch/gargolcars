---
import { siteConfig } from '../../config/site';
import { createWhatsAppUrl } from '../../utils/vehicle';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

const whatsappUrl = createWhatsAppUrl(
  siteConfig.contact.whatsapp.linkNumber,
  'Hola, quiero hacer una consulta a Gargol Cars.',
);
const phoneHref = `tel:+${siteConfig.contact.whatsapp.linkNumber}`;
---

<section
  id="contacto"
  class="contact-depth surface-ink section-atmosphere relative isolate scroll-mt-[var(--header-height)] overflow-hidden py-[var(--section-space)]"
  aria-labelledby="contact-title"
>
  <span class="section-separator" aria-hidden="true"></span>
  <img
    src="/images/brand/isotipo-blanco.png"
    alt=""
    width="1080"
    height="1080"
    loading="lazy"
    aria-hidden="true"
    class="pointer-events-none absolute -right-36 bottom-[-10rem] -z-10 w-[36rem] max-w-none object-contain opacity-[0.025] md:-right-28 md:w-[48rem]"
  />
  <Container class="relative z-10">
    <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-20">
      <div data-section-heading>
        <p class="section-eyebrow">
          Contacto
        </p>
        <h2
          id="contact-title"
          class="mt-4 max-w-[11ch] text-[length:var(--font-size-cta-title)] leading-[0.98] font-bold tracking-[-0.05em] text-balance text-[var(--color-text-primary)]"
        >
          Hablemos de tu próximo vehículo
        </h2>
        <p class="section-lead max-w-xl">
          Escribinos para consultar por una unidad, financiación, permutas u otras
          opciones disponibles.
        </p>
        <div class="mt-8 grid gap-3 sm:flex sm:flex-wrap">
          <Button href={whatsappUrl} class="min-h-12 w-full sm:w-auto">
            Consultar por WhatsApp
          </Button>
          <Button
            href={siteConfig.contact.address.mapsUrl}
            variant="secondary"
            class="min-h-12 w-full sm:w-auto"
          >
            Cómo llegar
          </Button>
        </div>
      </div>

      <div
        class="grid border-y border-[var(--color-border)] sm:grid-cols-2"
      >
        <article class="border-b border-[var(--color-border)] py-7 sm:col-span-2 sm:py-9">
          <p class="meta-label">WhatsApp</p>
          <a
            href={phoneHref}
            class="mt-3 inline-block text-[clamp(1.65rem,3vw,2.6rem)] leading-none font-bold tracking-[-0.035em] text-[var(--color-text-primary)] transition-colors duration-200 hover:text-[var(--color-brand-orange)]"
          >
            {siteConfig.contact.whatsapp.value}
          </a>
        </article>

        <article class="border-b border-[var(--color-border)] py-7 sm:border-r sm:pr-6">
          <p class="meta-label">Instagram</p>
          <a
            href={siteConfig.contact.instagram.value}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-block text-xl font-bold text-[var(--color-text-primary)] transition-colors duration-200 hover:text-[var(--color-brand-orange)]"
          >
            @gargolcars
          </a>
        </article>

        <article class="border-b border-[var(--color-border)] py-7 sm:pl-6">
          <p class="meta-label">Dirección</p>
          <address class="mt-3 text-base leading-7 font-semibold text-[var(--color-text-primary)] not-italic">
            {siteConfig.contact.address.value}
          </address>
        </article>

        <article class="py-7 sm:col-span-2">
          <p class="meta-label">Horarios</p>
          <dl class="mt-3 grid gap-2">
            {
              siteConfig.contact.businessHours.value.map(({ days, hours }) => (
                <div class="grid gap-1 text-sm">
                  <dt class="font-semibold text-[var(--color-text-primary)]">{days}</dt>
                  <dd class="text-[var(--color-text-secondary)]">{hours}</dd>
                </div>
              ))
            }
          </dl>
        </article>
      </div>
    </div>
  </Container>
</section>

<style>
  .contact-depth {
    background-image:
      radial-gradient(
        circle at 14% 48%,
        rgba(233, 87, 36, 0.13),
        transparent 27rem
      ),
      radial-gradient(
        circle at 92% 18%,
        rgba(119, 137, 153, 0.055),
        transparent 30rem
      );
  }

  @media (max-width: 47.999rem) {
    .contact-depth {
      background-image: radial-gradient(
        circle at 15% 25%,
        rgba(233, 87, 36, 0.085),
        transparent 19rem
      );
    }
  }
</style>
