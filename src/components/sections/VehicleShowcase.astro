---
import { vehicles } from '../../data/vehicles';
import { siteConfig } from '../../config/site';
import { createWhatsAppUrl } from '../../utils/vehicle';
import Container from '../ui/Container.astro';
import VehicleCard from '../ui/VehicleCard.astro';

const orderedVehicles = [...vehicles].sort(
  (firstVehicle, secondVehicle) =>
    Number(firstVehicle.status === 'sold') -
    Number(secondVehicle.status === 'sold'),
);
const availableVehicleCount = vehicles.filter(
  (vehicle) => vehicle.status !== 'sold',
).length;
const emptyStateWhatsappUrl = createWhatsAppUrl(
  siteConfig.contact.whatsapp.linkNumber,
  'Hola, no encontré una coincidencia exacta en la web. Quisiera consultar por otra alternativa.',
);
---

<section
  id="vehiculos"
  class="surface-graphite relative scroll-mt-[var(--header-height)] overflow-hidden py-[var(--section-space)]"
  aria-labelledby="vehicle-showcase-title"
>
  <span class="section-separator section-separator--bottom" aria-hidden="true"></span>
  <Container>
    <div class="max-w-3xl" data-section-heading>
      <p class="section-eyebrow">
        Stock seleccionado
      </p>
      <h2
        id="vehicle-showcase-title"
        class="section-title"
      >
        Encontrá tu próximo vehículo
      </h2>
      <p class="section-lead">
        Conocé nuestras unidades disponibles y consultanos directamente por la opción
        que más te interese.
      </p>
    </div>

    <p
      class="mt-8 flex items-center gap-2 text-xs font-semibold tracking-[0.08em] text-[var(--color-text-secondary)] uppercase sm:hidden"
    >
      Deslizá para ver más
      <span aria-hidden="true" class="text-lg text-[var(--color-brand-orange)]">→</span>
    </p>

    <div class="mt-8 flex min-h-12 flex-wrap items-center justify-between gap-3 border-t border-[var(--color-border)] pt-5 sm:mt-10">
      <p
        class="meta-label text-[var(--color-text-primary)]"
        aria-live="polite"
        aria-atomic="true"
        data-vehicle-result-count
      >
        {availableVehicleCount === 1
          ? '1 vehículo disponible'
          : `${availableVehicleCount} vehículos disponibles`}
      </p>
      <button
        type="button"
        class="min-h-12 rounded-[var(--radius)] px-3 py-2 text-sm font-semibold text-[var(--color-brand-orange)] underline-offset-4 transition-colors duration-200 hover:text-[#ff7040] hover:underline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--color-brand-orange)]"
        data-clear-vehicle-filters
        hidden
      >
        Limpiar filtros
      </button>
    </div>

    <div
      class="mt-5 border-y border-[var(--color-border)] bg-[var(--color-surface-soft)] px-5 py-8 sm:px-8"
      data-vehicle-empty-state
      hidden
    >
      <h3 class="text-2xl font-bold text-[var(--color-text-primary)]">
        No encontramos una coincidencia exacta
      </h3>
      <p class="mt-3 max-w-2xl text-base leading-7 text-[var(--color-text-secondary)]">
        Contanos qué vehículo buscás y nuestro equipo puede ayudarte a encontrar una
        alternativa.
      </p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a
          href="#solicitud"
          class="inline-flex min-h-12 items-center justify-center rounded-[var(--radius)] border border-[var(--color-brand-orange)] bg-[var(--color-brand-orange)] px-5 py-3 text-sm font-semibold text-white focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--color-brand-orange)]"
        >
          Solicitar un vehículo
        </a>
        <a
          href={emptyStateWhatsappUrl}
          class="inline-flex min-h-12 items-center justify-center rounded-[var(--radius)] border border-[var(--color-border)] bg-[var(--color-surface)] px-5 py-3 text-sm font-semibold text-[var(--color-text-primary)] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--color-brand-orange)]"
        >
          Consultar por WhatsApp
        </a>
      </div>
    </div>

    <div
      class="vehicle-showcase-track -mx-4 mt-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-5 sm:mx-0 sm:mt-6 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-3 lg:gap-x-6 lg:gap-y-8"
      aria-label="Unidades en exhibición"
      data-vehicle-grid
    >
      {
        orderedVehicles.map((vehicle) => (
          <div
            class="w-[86vw] max-w-[24rem] shrink-0 snap-start sm:w-auto sm:max-w-none sm:shrink sm:[scroll-snap-align:none]"
            data-vehicle-card
            data-brand={vehicle.brand}
            data-model={vehicle.model}
            data-price={vehicle.price}
            data-status={vehicle.status}
          >
            <VehicleCard vehicle={vehicle} />
          </div>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .vehicle-showcase-track {
    scrollbar-color: var(--color-brand-orange) var(--color-surface);
    scrollbar-width: thin;
  }

  .vehicle-showcase-track::-webkit-scrollbar {
    height: 0.4rem;
  }

  .vehicle-showcase-track::-webkit-scrollbar-track {
    border-radius: 999px;
    background: var(--color-surface);
  }

  .vehicle-showcase-track::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: var(--color-brand-orange);
  }
</style>
