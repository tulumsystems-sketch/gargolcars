---
import { siteConfig } from '../../config/site';
import { createWhatsAppUrl } from '../../utils/vehicle';
import Container from '../ui/Container.astro';

const currentYear = new Date().getFullYear();
const whatsappUrl = createWhatsAppUrl(
  siteConfig.contact.whatsapp.linkNumber,
  'Hola, quiero comunicarme con Gargol Cars.',
);
const navigation = [
  { label: 'Inicio', href: '#inicio' },
  { label: 'Vehículos', href: '#vehiculos' },
  { label: 'Financiación', href: '#financiacion' },
  { label: 'Nosotros', href: '#nosotros' },
  { label: 'Contacto', href: '#contacto' },
] as const;
---

<footer
  class="surface-black relative isolate overflow-hidden border-t border-[var(--color-border)] pt-12 pb-[calc(7rem+env(safe-area-inset-bottom))] md:pt-14 md:pb-10"
>
  <Container>
    <div class="grid gap-10 border-b border-[var(--color-border)] pb-10 md:grid-cols-[1fr_auto] md:gap-x-16">
      <div>
        <a
          href="#inicio"
          class="inline-flex rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-brand-orange)]"
          aria-label="Gargol Cars, volver al inicio"
        >
          <img
            src="/images/brand/logo-transparente.png"
            alt="Gargol Cars"
            width="1080"
            height="1080"
            loading="lazy"
            class="h-24 w-40 object-contain"
          />
        </a>
        <p class="mt-3 max-w-sm text-sm leading-6 text-[var(--color-text-secondary)]">
          Autos, pickups y motos. Consultas por financiación, permutas y unidades
          disponibles.
        </p>
      </div>

      <nav class="border-t border-[var(--color-border)] pt-6 md:order-3 md:col-span-2" aria-label="Navegación del pie">
        <p class="meta-label text-[var(--color-text-primary)]">Navegación</p>
        <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-3">
          {
            navigation.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="text-sm text-[var(--color-text-secondary)] transition-colors duration-200 hover:text-[var(--color-brand-orange)]"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="meta-label text-[var(--color-text-primary)]">Encontranos</p>
        <ul class="mt-4 grid gap-3 text-sm text-[var(--color-text-secondary)]">
          <li>
            <a href={whatsappUrl} class="transition-colors duration-200 hover:text-[var(--color-brand-orange)]">
              {siteConfig.contact.whatsapp.value}
            </a>
          </li>
          <li>
            <a
              href={siteConfig.contact.instagram.value}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors duration-200 hover:text-[var(--color-brand-orange)]"
            >
              Instagram
            </a>
          </li>
          <li class="max-w-xs">{siteConfig.contact.address.value}</li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-2 pt-6 text-xs text-[var(--color-text-secondary)] sm:flex-row sm:items-center sm:justify-between">
      <div class="grid gap-2">
        <p>© {currentYear} Gargol Cars. Todos los derechos reservados.</p>
        {
          siteConfig.isDemo && (
            <p class="text-[0.6875rem] tracking-[0.06em] text-white/40">
              Demostración conceptual no oficial
            </p>
          )
        }
      </div>
      <p class="sm:text-right">San Juan, Argentina.</p>
    </div>
  </Container>
</footer>
