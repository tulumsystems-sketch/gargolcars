---
import { siteConfig } from '../../config/site';
import { createWhatsAppUrl } from '../../utils/vehicle';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

const navigation = [
  { label: 'Inicio', href: '#inicio' },
  { label: 'Vehículos', href: '#vehiculos' },
  { label: 'Financiación', href: '#financiacion' },
  { label: 'Nosotros', href: '#nosotros' },
  { label: 'Contacto', href: '#contacto' },
] as const;
const whatsappUrl = createWhatsAppUrl(
  siteConfig.contact.whatsapp.linkNumber,
  'Hola, quiero hacer una consulta a Gargol Cars.',
);
---

<header
  class="site-header fixed top-0 right-0 left-0 z-50 border-b border-white/[0.06] bg-[color:var(--color-bg-primary)]/[0.36] backdrop-blur-xl"
  data-header
  data-header-state="transparent"
  data-gsap-header
>
  <Container class="flex min-h-16 items-center justify-between gap-2 sm:min-h-20 sm:gap-6">
    <a
      href="#inicio"
      class="header-logo-link flex shrink-0 items-center rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-brand-orange)]"
      aria-label="Gargol Cars, ir al inicio"
    >
      <span class="header-logo-frame">
        <img
          src="/images/brand/logo-transparente.png"
          alt="Gargol Cars"
          width="1080"
          height="1080"
          class="header-logo"
        />
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
      {
        navigation.map(({ label, href }) => (
          <a
            href={href}
            class="group relative rounded-lg px-3 py-2 text-[0.8125rem] font-semibold tracking-[0.035em] text-[var(--color-text-secondary)] transition-colors duration-200 hover:text-[var(--color-text-primary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-brand-orange)]"
          >
            {label}
            <span
              aria-hidden="true"
              class="absolute right-3 bottom-0 left-3 h-px origin-left scale-x-0 bg-[var(--color-brand-orange)] transition-transform duration-200 group-hover:scale-x-100 group-focus-visible:scale-x-100"
            >
            </span>
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block">
      <Button href={whatsappUrl} variant="secondary" class="gap-2 px-4 py-2 text-xs">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="size-4 text-[var(--color-brand-orange)]"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M4 4h4l2 5-3 2a14 14 0 0 0 6 6l2-3 5 2v4a2 2 0 0 1-2 2C9.2 22 2 14.8 2 6a2 2 0 0 1 2-2Z"></path>
        </svg>
        WhatsApp
      </Button>
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <a
        href={whatsappUrl}
        class="grid size-12 shrink-0 place-items-center rounded-full border border-[var(--color-border)] bg-[color:var(--color-surface)]/90 text-[var(--color-brand-orange)] transition-colors duration-200 hover:border-[var(--color-border-strong)] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--color-brand-orange)]"
        aria-label="Consultar por WhatsApp"
        title="Consultar por WhatsApp"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="size-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M4 4h4l2 5-3 2a14 14 0 0 0 6 6l2-3 5 2v4a2 2 0 0 1-2 2C9.2 22 2 14.8 2 6a2 2 0 0 1 2-2Z"></path>
        </svg>
      </a>

      <details class="group relative">
        <summary
          class="grid size-12 cursor-pointer list-none place-items-center rounded-[var(--radius)] border border-[var(--color-border)] bg-[color:var(--color-surface)]/90 text-[var(--color-text-primary)] marker:content-none transition-colors duration-200 hover:border-[var(--color-border-strong)] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--color-brand-orange)]"
          aria-label="Abrir menú de navegación"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="size-5 group-open:hidden"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="hidden size-5 group-open:block"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </summary>

        <div
          class="absolute right-0 top-[calc(100%+0.75rem)] w-[min(19rem,calc(100vw-2rem))] overflow-hidden rounded-[var(--radius-editorial)] border border-[var(--color-border)] bg-[color:var(--color-surface)]/95 p-3 shadow-[0_24px_70px_rgba(0,0,0,0.48)] backdrop-blur-xl"
        >
          <nav class="flex flex-col" aria-label="Navegación móvil">
            {
              navigation.map(({ label, href }) => (
                <a
                  href={href}
                  class="rounded-lg px-4 py-3 text-base font-medium text-[var(--color-text-secondary)] transition-colors duration-200 hover:bg-white/5 hover:text-[var(--color-text-primary)] focus-visible:outline-2 focus-visible:outline-[var(--color-brand-orange)]"
                >
                  {label}
                </a>
              ))
            }
          </nav>
          <Button href={whatsappUrl} class="mt-3 w-full">Contactar</Button>
        </div>
      </details>
    </div>
  </Container>
</header>

<style>
  .header-logo-frame {
    display: flex;
    width: 7.25rem;
    height: 4rem;
    align-items: center;
    justify-content: flex-start;
    overflow: visible;
  }

  .header-logo {
    width: auto !important;
    max-width: 100%;
    height: 4rem !important;
    object-fit: contain;
    object-position: left center;
  }

  @media (min-width: 40rem) {
    .header-logo-frame {
      width: 9rem;
      height: 5rem;
    }

    .header-logo {
      height: 5rem !important;
    }
  }
</style>
