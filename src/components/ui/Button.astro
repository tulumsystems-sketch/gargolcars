---
type ButtonVariant = 'primary' | 'secondary' | 'ghost';

interface Props {
  href?: string;
  variant?: ButtonVariant;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const {
  href,
  variant = 'primary',
  class: className,
  type = 'button',
} = Astro.props;

const baseClasses =
  'inline-flex min-h-11 items-center justify-center rounded-[var(--radius)] px-5 py-3 text-sm font-semibold tracking-wide transition-colors focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--color-brand-orange)]';

const variantClasses: Record<ButtonVariant, string> = {
  primary:
    'border border-[var(--color-brand-orange)] bg-[var(--color-brand-orange)] text-white hover:border-[#ff7040] hover:bg-[#ff7040]',
  secondary:
    'border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-primary)] hover:border-[var(--color-brand-gray)] hover:bg-[var(--color-surface-raised)]',
  ghost:
    'border border-transparent bg-transparent text-[var(--color-text-primary)] hover:border-[var(--color-border)] hover:bg-white/5',
};

const classes = [baseClasses, variantClasses[variant], className];
---

{
  href ? (
    <a href={href} class:list={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes}>
      <slot />
    </button>
  )
}
