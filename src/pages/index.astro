---
import Header from '../components/layout/Header.astro';
import HeroSearch from '../components/sections/HeroSearch.astro';
import VehicleShowcase from '../components/sections/VehicleShowcase.astro';
import Container from '../components/ui/Container.astro';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <Header />
  <HeroSearch />
  <VehicleShowcase />

  <section
    id="contacto"
    class="scroll-mt-20 border-t border-[var(--color-border)] bg-[var(--color-bg-primary)] py-8"
    aria-label="Contacto"
  >
    <Container>
      <p class="text-center text-sm text-[var(--color-text-secondary)]">
        Información de contacto pendiente de confirmación.
      </p>
    </Container>
  </section>
</BaseLayout>
