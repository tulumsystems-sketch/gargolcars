---
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <section class="grid min-h-screen place-items-center px-6 text-center">
    <div>
      <h1 class="text-3xl font-semibold">{siteConfig.name}</h1>
      <p class="mt-3">La estructura base del sitio funciona correctamente.</p>
    </div>
  </section>
</BaseLayout>
